# --- Backend ---
# http   = call a backend at VITE_API_BASE_URL (the bundled mock server or your real API)
# memory = in-browser mock data, no server needed (single app only; not shared with the other apps)
VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:4000
# true only when VITE_API_BASE_URL points at the bundled mock server (shows "Mock data"/demo tools)
VITE_MOCK_BACKEND=true

# --- Site / location check ---
# Comma-separated site codes accepted from a ?site= link (empty = any 3–24 char code); the first is the default
VITE_SITE_CODES=ED-MAIN
# Hospital coordinates for the "are you leaving?" check. If empty, the patient's check-in position is used.
VITE_HOSPITAL_LAT=
VITE_HOSPITAL_LNG=
VITE_EXIT_RADIUS_METERS=150
